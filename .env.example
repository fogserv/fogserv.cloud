# Local Development Database
# For local development, use SQLite. For production, use Prisma Accelerate with PostgreSQL
DATABASE_URL="file:./dev.db"

# Prisma ORM - Uses Prisma Accelerate for connection pooling
# Format: prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_API_KEY
PRISMA_ORM=prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_PRISMA_ACCELERATE_KEY

# Direct PostgreSQL Connection
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
PRISMA_ANY=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Git Repository Credentials (if needed for automated deployments)
# GIT_TOKEN=your_token_here
# GIT_USERNAME=your_username_here

# API Keys and Service Credentials
# Add additional secrets here as needed
# API_KEY=your_api_key_here

# Mailgun (Phase 4)
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=mg.fogserv.cloud
MAILGUN_FROM_EMAIL=noreply@fogserv.cloud
MAILGUN_WEBHOOK_SIGNING_KEY=your_mailgun_webhook_signing_key
APP_BASE_URL=http://localhost:5173

# Frontend Email Service Mode
# Use "console" during local development until backend email endpoints are live.
VITE_EMAIL_PROVIDER=api
VITE_EMAIL_API_BASE_URL=/api
