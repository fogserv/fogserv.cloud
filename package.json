{
  "name": "fogserv-website",
  "version": "0.1.0",
  "description": "The AI-Managed Server - fogserv.cloud official website",
  "type": "module",
  "scripts": {
    "dev": "dotenvx run -- vite",
    "build": "dotenvx run -- vite build",
    "start": "dotenvx run -- vite preview",
    "preview": "dotenvx run -- vite preview",
    "db:push": "dotenvx run -- prisma db push",
    "db:generate": "dotenvx run -- prisma generate",
    "db:migrate": "dotenvx run -- prisma migrate dev",
    "db:studio": "dotenvx run -- prisma studio",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "import:ghost": "dotenvx run -- bun run scripts/import-ghost.ts",
    "secrets:encrypt": "dotenvx encrypt",
    "secrets:decrypt": "dotenvx decrypt",
    "secrets:get": "dotenvx get"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-router": "^1.170.1",
    "@tanstack/start": "^1.120.20",
    "@tiptap/extension-character-count": "^3.23.4",
    "@tiptap/extension-code-block-lowlight": "^3.23.4",
    "@tiptap/extension-image": "^3.23.4",
    "@tiptap/extension-link": "^3.23.4",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/pm": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "lowlight": "^3.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.66.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/router-devtools": "^1.167.0",
    "@tanstack/router-plugin": "^1.168.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react": "^7.37.5",
    "postcss": "^8.5.14",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  },
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.0.0"
  }
}
